# Runtime connection (restricted role: row-level security applies, audit rows are append-only)
DATABASE_URL=postgresql+psycopg://bazaar_app:bazaar_app@127.0.0.1:5432/bazaar
# Owner connection (migrations, seed, demo reset)
OWNER_DATABASE_URL=postgresql+psycopg://bazaar_owner:bazaar_owner@127.0.0.1:5432/bazaar

# Test database (pytest recreates the schema on every run)
TEST_DATABASE_URL=postgresql+psycopg://bazaar_app:bazaar_app@127.0.0.1:5432/bazaar_test
TEST_OWNER_DATABASE_URL=postgresql+psycopg://bazaar_owner:bazaar_owner@127.0.0.1:5432/bazaar_test

# Name of the runtime role that the migration grants privileges to
APP_DB_ROLE=bazaar_app

# Sessions
JWT_SECRET=dev-only-secret-change-me-before-any-real-deployment
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# Marketplace rules
HOLDBACK_DAYS=7
RESERVATION_MINUTES=15
